[Unit]
Description=Meshtastic Terminal Monitor (GPS / Battery / Mesh messages)
Documentation=https://github.com/natek777/Hackberry-Pi_Zero/tree/main/Meshtastic
After=meshtastic-gps-bridge.service

[Service]
Type=simple
User=pi
# Set a real terminal so curses works
Environment=TERM=xterm-256color
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
# Adjust --port if your device enumerates differently
ExecStart=/usr/bin/python3 /home/pi/Meshtastic/meshtastic_monitor.py \
    --port /dev/ttyACM0
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
